# Server process configuration. Keep this SQLite directory on a durable local volume.
# Set an absolute path appropriate to your deployment.
SHARP_GLOBAL_DB_PATH=data/global-hotspots.sqlite
SHARP_GLOBAL_INGEST_ENABLED=1
SHARP_GLOBAL_REFRESH_SECONDS=900
SHARP_GLOBAL_STALE_SECONDS=3600
SHARP_GLOBAL_RETAIN_SNAPSHOTS=8
SHARP_GLOBAL_RETAIN_DAYS=14
SHARP_GLOBAL_MAX_SOURCE_RECORDS=1500000
SHARP_GLOBAL_SOURCES=MODIS_NRT,VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT

# Shared conservative MAP_KEY transaction reservations for AOI fallbacks.
# Public bulk ingestion does not require FIRMS_MAP_KEY.
# Set FIRMS_MAP_KEY separately in the server environment; never commit a real key.
SHARP_FIRMS_TRANSACTION_LIMIT=5000
SHARP_FIRMS_HEADROOM=1000
SHARP_FIRMS_LOCAL_BUDGET=3000
SHARP_FIRMS_WORLD_DAY_COST=1200
SHARP_FIRMS_AVAILABILITY_COST=10
SHARP_FIRMS_OTHER_COST=100
SHARP_FIRMS_MAX_QUEUED=64
